# Copy to .env with mode 0600. Use scripts/create-secrets.py for random local credentials.
HAVEN_NAME=HAVEN
HAVEN_SECRET_KEY=
POSTGRES_PASSWORD=
POSTGRES_DB=haven
POSTGRES_USER=haven
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Set exact literal IP and origin; never use wildcard hosts or origins.
HAVEN_HOSTS=
HAVEN_ORIGINS=
# Optional exact HTTPS hostname for WebAuthn PRF unlock. Keep literal IP hosts/origins too.
# Requires DNS/hosts resolution, a trusted DNS-SAN leaf, and explicit re-enrollment at the new origin.
HAVEN_OPTIONAL_HOSTNAME=
HAVEN_MAINTENANCE=Security qualification incomplete. Messaging disabled.
# Certificate path directory must contain leaf.crt (full chain) and leaf.key, never the root signing key.
HAVEN_TLS_DIR=
# Explicitly local images created by make production-build.
HAVEN_API_IMAGE=haven-api:0.2.0
HAVEN_WEB_IMAGE=haven-web:0.2.0

# Database bootstrap, migrations, and runtime must use distinct credentials.
HAVEN_DB_MIGRATION_USER=haven_migrate
HAVEN_DB_MIGRATION_PASSWORD=REPLACE_WITH_48_RANDOM_CHARACTERS
HAVEN_DB_RUNTIME_USER=haven_app
HAVEN_DB_RUNTIME_PASSWORD=REPLACE_WITH_DIFFERENT_48_RANDOM_CHARACTERS

# Optional manually prepared primary/standby mode; see operations.md before use.
# HAVEN_PRIMARY_TUNNEL_IP=
# HAVEN_PRIMARY_BRIDGE_CONFIG=/protected/primary-bridge.conf
# HAVEN_BRIDGE_TLS_DIR=/protected/primary-bridge-leaf
# HAVEN_STANDBY_PREPARATION_CONFIG=/protected/standby-preparation.conf
# HAVEN_PRIMARY_BRIDGE_ROOTS=/protected/public-primary-ca-bundle.pem
