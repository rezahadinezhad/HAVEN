FROM python:3.12.15-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MLS_PUBLIC_VERIFIER=/usr/local/bin/haven-public-verify
WORKDIR /app
COPY apps/api/requirements.lock /app/requirements.lock
COPY offline-deps/wheels /wheels
RUN pip install --no-index --find-links=/wheels --require-hashes -r requirements.lock && rm -rf /wheels && useradd --uid 10001 --create-home haven
COPY --chown=10001:10001 apps/api /app
COPY --chmod=0555 packages/crypto-core/bin/haven-public-verify-x86_64-linux /usr/local/bin/haven-public-verify
RUN test "$(uname -m)" = x86_64
RUN python -m pip uninstall -y pip
USER 10001:10001
EXPOSE 8100
CMD ["uvicorn", "haven.asgi:application", "--host", "0.0.0.0", "--port", "8100", "--no-access-log", "--proxy-headers", "--forwarded-allow-ips", "*", "--ws-max-size", "2048"]
