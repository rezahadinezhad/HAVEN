user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
# Nginx error records can contain complete request URLs (including invite tokens).
# Use bounded application counters/health checks; enable diagnostics only with synthetic traffic.
error_log /dev/null;
events { worker_connections 1024; }
http {
  access_log off;
  server_tokens off;
  client_max_body_size 1400k;
  client_body_buffer_size 1400k;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_max_temp_file_size 0;
  map $http_upgrade $bridge_connection { default upgrade; '' close; }
  server {
    listen @BRIDGE_LISTEN@ ssl;
    ssl_certificate /etc/haven/bridge-tls/leaf.crt;
    ssl_certificate_key /etc/haven/bridge-tls/leaf.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    allow @BACKUP_PEER_IP@;
    deny all;
    # Login source is overwritten at public ingress and relayed only by the allowed backup peer.
    location = /api/v1/auth/login {
      proxy_pass http://@API_UPSTREAM@;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For $http_x_forwarded_for;
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location /api/v1/ {
      proxy_pass http://@API_UPSTREAM@;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location = /ws/v1 {
      proxy_pass http://@API_UPSTREAM@;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $bridge_connection;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
      proxy_connect_timeout 5s;
      proxy_read_timeout 75s;
    }
    location / { return 404; }
  }
}
