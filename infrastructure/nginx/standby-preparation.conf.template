user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
# Nginx error records can contain complete request URLs (including invite tokens).
# Use bounded application counters/health checks; enable diagnostics only with synthetic traffic.
error_log /dev/null;
events { worker_connections 1024; }
http {
  include /etc/nginx/mime.types;
  access_log off;
  server_tokens off;
  client_max_body_size 1400k;
  client_body_buffer_size 1400k;
  proxy_request_buffering off;
  proxy_buffering off;
  proxy_max_temp_file_size 0;
  map $http_upgrade $bridge_connection { default upgrade; '' close; }
  server {
    listen @PUBLIC_LISTEN@ ssl;
    ssl_certificate /etc/haven/tls/leaf.crt;
    ssl_certificate_key /etc/haven/tls/leaf.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security 'max-age=31536000' always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Permissions-Policy 'camera=(), microphone=(self), geolocation=()' always;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 3;
    proxy_ssl_trusted_certificate /etc/haven/primary-roots.pem;
    proxy_ssl_server_name on;
    proxy_ssl_name haven-primary;
    location /api/v1/ {
      proxy_pass https://@PRIMARY_CONNECT_IP@:9443;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
      proxy_connect_timeout 5s;
      proxy_read_timeout 60s;
    }
    location = /ws/v1 {
      proxy_pass https://@PRIMARY_CONNECT_IP@:9443;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $bridge_connection;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
      proxy_connect_timeout 5s;
      proxy_read_timeout 75s;
    }
    @LOCAL_HARNESS@
    location / {
      proxy_pass http://@WEB_UPSTREAM@;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Proto https;
      proxy_set_header X-Real-IP "";
      proxy_set_header X-Forwarded-For "";
      proxy_set_header Forwarded "";
      proxy_set_header X-Client-IP "";
      proxy_set_header True-Client-IP "";
      proxy_set_header CF-Connecting-IP "";
      proxy_set_header X-Forwarded-Host "";
    }
  }
}
