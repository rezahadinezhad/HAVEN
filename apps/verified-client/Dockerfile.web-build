FROM node:26.13.0-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 AS build
WORKDIR /workspace
COPY apps/web/package.json apps/web/package-lock.json ./apps/web/
RUN cd apps/web && npm ci --ignore-scripts
COPY apps/web ./apps/web
COPY apps/verified-client/web ./apps/verified-client/web
COPY scripts/build-verified-client.mjs ./scripts/build-verified-client.mjs
ENV HAVEN_CLIENT_BUILD_DIR=/out
RUN node scripts/build-verified-client.mjs
FROM scratch
COPY --from=build /out /web
